# =============================================================================
# Supabase Configuration
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# Multi-Cloudinary Configuration (4 Category-Based Accounts)
# =============================================================================
# Account 1: Tops & Kurtis
VITE_CLOUDINARY_TOPS_KURTIS_CLOUD_NAME=dm-tops-kurtis
VITE_CLOUDINARY_TOPS_KURTIS_PRESET=shop_products_upload

# Account 2: One Piece & Dresses
VITE_CLOUDINARY_DRESSES_CLOUD_NAME=dm-dresses-onepiece
VITE_CLOUDINARY_DRESSES_PRESET=shop_products_upload

# Account 3: Denims & Shorts (Bottoms)
VITE_CLOUDINARY_BOTTOMS_CLOUD_NAME=dm-bottoms-shorts
VITE_CLOUDINARY_BOTTOMS_PRESET=shop_products_upload

# Account 4: Traditional Wear & Others (Coord Sets, etc.)
VITE_CLOUDINARY_TRADITIONAL_CLOUD_NAME=dm-traditional-other
VITE_CLOUDINARY_TRADITIONAL_PRESET=shop_products_upload

# Fallback / Legacy Cloudinary Account
VITE_CLOUDINARY_FALLBACK_CLOUD_NAME=dvdxdqnie
VITE_CLOUDINARY_FALLBACK_PRESET=shop_products_upload
